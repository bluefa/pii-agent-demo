#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "${repo_root}"

# Promote the pre-commit validation marker to the freshly-created HEAD SHA, so
# downstream tooling (pre-bash-pr-create hook, stop-verify hook, pr-check.sh)
# can recognize the new commit as already validated and skip duplicate work.
# Only promote when HEAD's tree is the tree pre-commit actually validated:
# git's sequencer fires this hook for every commit `rebase --continue` creates,
# and a rebase replays the commit onto a NEW base — same diff, different tree.
# Blind promotion stamped that never-validated merged tree as PASS and
# pr-check.sh skipped lint/tsc/test/build on it (false cache hit, 2026-08-23).
marker="$(git rev-parse --git-path pii-pre-commit-validated.env 2>/dev/null || true)"
if [ -n "$marker" ] && [ -f "$marker" ]; then
  head_sha="$(git rev-parse HEAD 2>/dev/null || echo "")"
  head_tree="$(git rev-parse 'HEAD^{tree}' 2>/dev/null || echo "")"
  validated_tree="$(sed -n 's/^tree=//p' "$marker" 2>/dev/null | head -1)"
  if [ -n "$head_sha" ] && [ -n "$head_tree" ] && [ "$head_tree" = "$validated_tree" ]; then
    tmp="${marker}.tmp"
    {
      grep -v '^head=' "$marker" 2>/dev/null || true
      printf 'head=%s\n' "$head_sha"
    } >"$tmp"
    mv "$tmp" "$marker"
  fi
fi

