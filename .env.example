# Environment variables for the PII Agent frontend (LIN-60).
# Copy to `.env.local` for local development. Validated at build (next.config.ts)
# and at server boot (instrumentation.ts) — see docs/adr/024.

# BFF_API_URL — upstream BFF base URL. REQUIRED in real mode; the server refuses
# to boot without it (fail-fast instead of silent relative-fetch failures).
BFF_API_URL=http://localhost:8082

# USE_MOCK_DATA — set to "true" ONLY for local mock development. Unset (or any
# other value) = real mode. NODE_ENV=production + USE_MOCK_DATA=true is refused
# at both build and boot (a PII tool must never serve seed data).
# USE_MOCK_DATA=true

# NEXT_PUBLIC_*_URL — external consoles the top nav links to. Absolute https URLs.
# Unset ⇒ that nav item stays disabled ("준비 중" toast).
# NEXT_PUBLIC_CREDENTIALS_URL=https://credentials.example.com
# NEXT_PUBLIC_PII_TAG_URL=https://pii-tag.example.com
# NEXT_PUBLIC_PII_MAP_URL=https://pii-map.example.com
